PORT=5000
NODE_ENV=development

# Database Configuration
# Default: SQLite (matches prisma/schema.prisma provider = "sqlite" for zero-configuration local setup)
DATABASE_URL="file:./dev.db"
# If switching prisma/schema.prisma provider to "postgresql":
# DATABASE_URL="postgresql://username:password@localhost:5432/clientflow?schema=public"

# Authentication & JWT Secrets
JWT_ACCESS_SECRET=replace_with_a_secure_random_jwt_access_secret
JWT_REFRESH_SECRET=replace_with_a_secure_random_jwt_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS & Uploads
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=./uploads

